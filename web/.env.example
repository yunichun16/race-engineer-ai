# Copy to .env.local (gitignored) to change these. They are read at build time (the NEXT_PUBLIC_
# ones are inlined into the browser bundle), so restart `next dev` or rebuild after a change. On
# Vercel, set them in the project's Environment Variables for Production and Preview.

# The FastAPI server the browser calls directly. Leave unset for http://127.0.0.1:8000
# (`make api-fake` or `make api`). A site on another origin also needs that origin in the API's
# RACE_ENGINEER_CORS_ORIGINS. A production build also names it in the Content Security Policy's
# connect-src, and a Vercel production build fails without an https:// address here
# (scripts/check-env.ts).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# The public repository (M7). Empty: report references stay plain text and the header shows no
# repository icon.
NEXT_PUBLIC_REPO_URL=

# The site's own address, for the sharing image tags, robots.txt and the sitemap. Only for a
# custom domain: empty, a Vercel build uses the project's production domain
# (VERCEL_PROJECT_PRODUCTION_URL, which Vercel sets) and a local build http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
